{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sap-nexus-agent.local/schemas/analysis-fact-fields.schema.json",
  "title": "SAP Nexus Analysis-Legal Fact Field Allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "allowlist"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "allowlist": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factTypeId", "fields"],
      "properties": {
        "factTypeId": { "type": "string", "pattern": "^sapnexus:[A-Za-z]+Fact$" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "semanticType"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "semanticType": { "type": "string", "pattern": "^sapnexus:[A-Za-z]+$" }
      }
    }
  }
}
