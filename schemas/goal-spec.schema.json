{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sap-nexus-agent.local/schemas/goal-spec.schema.json",
  "title": "SAP Nexus GoalSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goalSpecVersion",
    "goalId",
    "goalType",
    "executionMode",
    "desiredFactTypes",
    "constraints"
  ],
  "properties": {
    "goalSpecVersion": { "type": "integer", "const": 1 },
    "goalId": { "type": "string", "minLength": 1 },
    "goalType": { "type": "string", "minLength": 1 },
    "executionMode": { "type": "string", "enum": ["PLAN_ONLY", "READ_ONLY"] },
    "desiredFactTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/constraint" }
    }
  },
  "$defs": {
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "semanticType", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "semanticType": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "integer", "boolean"] }
      }
    }
  }
}
