{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sap-nexus-agent.local/schemas/capability.schema.json",
  "title": "SAP Nexus Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capabilities"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "name",
        "description",
        "status",
        "kind",
        "domain",
        "businessObject",
        "ontologyIri",
        "semanticType",
        "inputs",
        "outputs",
        "executor",
        "executorBinding",
        "evalLinkage",
        "governance"
      ],
      "properties": {
        "capabilityId": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "kind": { "type": "string", "enum": ["Function", "Action"] },
        "domain": { "type": "string", "minLength": 1 },
        "businessObject": { "type": "string", "minLength": 1 },
        "ontologyIri": { "type": "string", "minLength": 1 },
        "semanticType": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ioField" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outputField" }
        },
        "executor": { "$ref": "#/$defs/executor" },
        "executorBinding": { "$ref": "#/$defs/executorBinding" },
        "evalLinkage": { "$ref": "#/$defs/evalLinkage" },
        "governance": { "$ref": "#/$defs/governance" },
        "narrative": { "$ref": "#/$defs/narrative" },
        "intent": { "$ref": "#/$defs/intentBlock" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "Function" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "governance": {
                "properties": {
                  "sideEffect": { "const": "none" },
                  "requiresApproval": { "const": false },
                  "approvalPolicy": { "const": "not_required" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "Action" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "governance": {
                "properties": {
                  "sideEffect": { "const": "sap_write" },
                  "requiresApproval": { "const": true },
                  "approvalPolicy": { "const": "human_required" }
                }
              }
            }
          }
        }
      ]
    },
    "ioField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "semanticType", "bindingKind", "required", "type", "sapParameter"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "semanticName": { "type": "string", "minLength": 1 },
        "semanticType": { "type": "string", "minLength": 1 },
        "bindingKind": { "type": "string", "enum": ["identifier", "fact"] },
        "satisfiableByFactType": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "type": { "type": "string", "enum": ["string", "number", "integer", "boolean", "object", "array"] },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "sapParameter": { "type": "string", "minLength": 1 },
        "extraction": { "$ref": "#/$defs/extractionBlock" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "bindingKind": { "const": "fact" } },
            "required": ["bindingKind"]
          },
          "then": { "required": ["satisfiableByFactType"] }
        },
        {
          "if": {
            "properties": { "bindingKind": { "const": "identifier" } },
            "required": ["bindingKind"]
          },
          "then": { "not": { "required": ["satisfiableByFactType"] } }
        }
      ]
    },
    "outputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "semanticType", "type", "evidenceRole"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "semanticType": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["string", "number", "integer", "boolean", "object", "array"] },
        "evidenceRole": { "type": "string", "minLength": 1 },
        "factTypeRef": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "evidenceRole": { "const": "primaryFact" } },
            "required": ["evidenceRole"]
          },
          "then": { "required": ["factTypeRef"] }
        }
      ]
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["JCO_RFC", "ODATA"] },
        "rfcName": { "type": "string", "minLength": 1 },
        "inputMapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "outputMapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "JCO_RFC" } }, "required": ["type"] },
          "then": { "required": ["rfcName", "inputMapping", "outputMapping"] }
        }
      ]
    },
    "executorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bindingId"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["JCO_RFC", "ODATA", "CDS_ADT", "CDS_ODATA", "REST_JSON"]
        },
        "bindingId": { "type": "string", "minLength": 1 }
      }
    },
    "evalLinkage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evalFile", "caseIds"],
      "properties": {
        "evalFile": { "type": "string", "minLength": 1 },
        "caseIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sideEffect",
        "requiresApproval",
        "approvalPolicy",
        "dataClassification",
        "auditRequired"
      ],
      "properties": {
        "sideEffect": { "type": "string", "enum": ["none", "read", "write", "sap_write"] },
        "requiresApproval": { "type": "boolean" },
        "approvalPolicy": { "type": "string", "enum": ["not_required", "human_required"] },
        "dataClassification": { "type": "string", "minLength": 1 },
        "auditRequired": { "type": "boolean" }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factShape", "promptTemplate", "fallbackTemplate", "fieldMapping", "detailFormatter"],
      "properties": {
        "factShape": { "type": "string", "enum": ["single-value", "list", "action-receipt"] },
        "promptTemplate": { "type": "string", "minLength": 1 },
        "fallbackTemplate": { "type": "string", "minLength": 1 },
        "fieldMapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "detailFormatter": { "type": "string", "enum": ["mrp-table", "po-list", "none"] }
      }
    },
    "intentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intentName", "primaryKeywords"],
      "properties": {
        "intentName": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier of the intent this capability realizes."
        },
        "primaryKeywords": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Strong trigger keywords; at least one is required. Must stay disjoint from weakKeywords (enforced by the validator, not expressible in plain JSON Schema)."
        },
        "weakKeywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Weak confirmation keywords that only reinforce a primary hit."
        },
        "triggerKeywords": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Override for the trigger keyword set; defaults to primaryKeywords when absent."
        },
        "fieldNames": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "description": "Per-locale display names for input fields, keyed by locale then field name."
        },
        "requireAny": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "missingName"],
          "properties": {
            "inputs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "missingName": { "type": "string", "minLength": 1 }
          },
          "description": "If none of these input fields could be extracted, ask for missingName."
        },
        "clarifyPrompt": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/localePrompt" },
          "description": "Per-locale clarification prompt cases and fallback template."
        }
      }
    },
    "localePrompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": ["groupByBindingKind"],
          "description": "Rendering strategy: missing fields are grouped by binding source kind; at most one prompt per group per round, rendered from fieldNames display names."
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "default": 2,
          "description": "Clarify round budget per capability; exhaustion degrades to the fallback template."
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["missing", "text"],
            "properties": {
              "missing": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "text": { "type": "string", "minLength": 1 }
            }
          },
          "description": "Optional exact missing-set override, checked before strategy rendering."
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template"],
          "properties": { "template": { "type": "string", "minLength": 1 } },
          "description": "Template rendered when the strategy budget is exhausted (or when no strategy is declared and no case matches)."
        }
      }
    },
    "extractionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchers"],
      "properties": {
        "matchers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/extractionMatcher" }
        },
        "priority": { "type": "integer" },
        "excludes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "resolver": { "enum": ["date", "quantity", "text"] },
        "when": { "$ref": "#/$defs/extractionCondition" },
        "requiredWhen": { "$ref": "#/$defs/extractionCondition" },
        "reaskSuspect": { "type": "boolean" }
      }
    },
    "extractionMatcher": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["keyword", "regex", "semanticType"] },
        "pattern": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "ignoreCase": { "type": "boolean" },
        "scan": { "enum": ["first", "all"] }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "keyword" } } },
          "then": { "required": ["pattern", "value"] } },
        { "if": { "properties": { "kind": { "const": "regex" } } },
          "then": { "required": ["pattern"] } },
        { "if": { "properties": { "kind": { "const": "semanticType" } } },
          "then": { "required": ["ref"] } }
      ]
    },
    "extractionCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "equals": { "type": "string" }
      }
    }
  }
}
