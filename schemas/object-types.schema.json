{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sap-nexus-agent.local/schemas/object-types.schema.json",
  "title": "SAP Nexus Semantic Object Type Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "objectTypes"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "objectTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objectType" }
    }
  },
  "$defs": {
    "objectType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectTypeId", "semanticType", "keyFields", "scopeFields"],
      "properties": {
        "objectTypeId": {
          "type": "string",
          "pattern": "^sapnexus:[A-Za-z]+$"
        },
        "semanticType": { "type": "string", "pattern": "^sapnexus:[A-Za-z]+$" },
        "keyFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-zA-Z]*$" }
        },
        "scopeFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-zA-Z]*$" }
        }
      }
    }
  }
}
