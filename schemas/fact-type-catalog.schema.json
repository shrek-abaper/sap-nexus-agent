{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sap-nexus-agent.local/schemas/fact-type-catalog.schema.json",
  "title": "SAP Nexus Fact Type Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "factTypes"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "factTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/factType" }
    }
  },
  "$defs": {
    "factType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factTypeId",
        "name",
        "description",
        "businessObject",
        "predicate",
        "semanticType",
        "keyedBy"
      ],
      "properties": {
        "factTypeId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "businessObject": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "semanticType": { "type": "string", "minLength": 1 },
        "keyedBy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
