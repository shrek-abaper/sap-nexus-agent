{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sap-nexus:semantic-type-catalog:v1",
  "title": "Semantic-type extraction catalog",
  "description": "Shared semantic-type catalog (registry/semantic-types.yaml). Each entry is keyed by its `id`, which capability input matchers reference via {\"kind\": \"semanticType\", \"ref\": \"<entryId>\"}. Duplicate entry ids are allowed by this schema and rejected by the registry validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "semanticTypes"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Catalog revision; bumped on every structural change."
    },
    "semanticTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "matchers", "priority"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable identifier referenced by capability matchers."
          },
          "description": {"type": "string"},
          "priority": {
            "type": "integer",
            "description": "Resolution priority when multiple entries match."
          },
          "matchers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": {"enum": ["keyword", "regex", "semanticType"]},
                "pattern": {"type": "string", "minLength": 1},
                "value": {"type": "string", "minLength": 1},
                "ref": {"type": "string", "minLength": 1},
                "ignoreCase": {"type": "boolean"},
                "scan": {"enum": ["first", "all"]}
              },
              "allOf": [
                {"if": {"properties": {"kind": {"const": "keyword"}}},
                 "then": {"required": ["pattern", "value"]}},
                {"if": {"properties": {"kind": {"const": "regex"}}},
                 "then": {"required": ["pattern"]}},
                {"if": {"properties": {"kind": {"const": "semanticType"}}},
                 "then": {"required": ["ref"]}}
              ]
            }
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minLength": {"type": "integer", "minimum": 1},
              "notIn": {"type": "array", "items": {"type": "string"}},
              "prefixBlacklist": {"type": "array", "items": {"type": "string"}},
              "toUpperCaseCompare": {"type": "boolean"},
              "toUpperCaseOutput": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
