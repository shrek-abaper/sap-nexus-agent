{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sap-nexus-agent.local/schemas/capability-relation.schema.json",
  "title": "SAP Nexus Capability Relation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "relations"],
  "properties": {
    "version": { "type": "integer", "const": 2 },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "$defs": {
    "relation": {
      "oneOf": [
        { "$ref": "#/$defs/dependsOn" },
        { "$ref": "#/$defs/precondition" }
      ]
    },
    "dependsOn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationId", "relationType", "capabilityId", "dependsOnCapabilityId", "origin"],
      "properties": {
        "relationId": { "type": "string", "minLength": 1 },
        "relationType": { "const": "dependsOn" },
        "capabilityId": { "type": "string", "minLength": 1 },
        "dependsOnCapabilityId": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/origin" },
        "justification": { "$ref": "#/$defs/justification" }
      },
      "allOf": [{ "$ref": "#/$defs/manualRequiresJustification" }]
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationId", "relationType", "capabilityId", "requiredFactType", "origin"],
      "properties": {
        "relationId": { "type": "string", "minLength": 1 },
        "relationType": { "const": "precondition" },
        "capabilityId": { "type": "string", "minLength": 1 },
        "requiredFactType": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/origin" },
        "justification": { "$ref": "#/$defs/justification" }
      },
      "allOf": [{ "$ref": "#/$defs/manualRequiresJustification" }]
    },
    "origin": {
      "description": "How this relation came to exist. 'derived' means the deriver computes it from Fact Type field semantic types; 'manual' means it cannot be computed and a human asserted it.",
      "enum": ["derived", "manual"]
    },
    "justification": {
      "description": "Why a manual relation cannot be computed. Required on origin: manual.",
      "type": "string",
      "minLength": 1
    },
    "manualRequiresJustification": {
      "if": {
        "properties": { "origin": { "const": "manual" } },
        "required": ["origin"]
      },
      "then": { "required": ["justification"] }
    }
  }
}
