<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:sapnexus="https://sap-nexus-agent.local/ontology#">

  <owl:Ontology rdf:about="https://sap-nexus-agent.local/ontology/mm-material">
    <owl:imports rdf:resource="https://sap-nexus-agent.local/ontology/core"/>
  </owl:Ontology>

  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#MaterialInfo">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#BusinessObject"/>
  </owl:Class>

  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#MaterialInfoFact">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#ReasoningFact"/>
  </owl:Class>

  <!-- Mirrors predicate declared in ontology/fact-types.yaml; functional:
       one material-info fact per material + plant (fact keyedBy). -->
  <owl:FunctionalProperty rdf:about="https://sap-nexus-agent.local/ontology#hasMaterialInfo">
    <rdfs:domain rdf:resource="https://sap-nexus-agent.local/ontology#MaterialInfo"/>
    <rdfs:range rdf:resource="https://sap-nexus-agent.local/ontology#MaterialInfoFact"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </owl:FunctionalProperty>

  <owl:NamedIndividual rdf:about="https://sap-nexus-agent.local/ontology#MM_Material_GetInfo">
    <rdf:type rdf:resource="https://sap-nexus-agent.local/ontology#Function"/>
    <rdfs:label>MM.Material.GetInfo</rdfs:label>
  </owl:NamedIndividual>
</rdf:RDF>
