<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:sapnexus="https://sap-nexus-agent.local/ontology#">

  <owl:Ontology rdf:about="https://sap-nexus-agent.local/ontology/mm-inventory">
    <owl:imports rdf:resource="https://sap-nexus-agent.local/ontology/core"/>
  </owl:Ontology>

  <owl:Class rdf:about="sapnexus:Material">
    <rdfs:subClassOf rdf:resource="sapnexus:BusinessObject"/>
  </owl:Class>
  <owl:Class rdf:about="sapnexus:Plant">
    <rdfs:subClassOf rdf:resource="sapnexus:BusinessObject"/>
  </owl:Class>
  <owl:Class rdf:about="sapnexus:InventoryStock">
    <rdfs:subClassOf rdf:resource="sapnexus:BusinessObject"/>
  </owl:Class>
  <owl:Class rdf:about="sapnexus:AvailableQuantity"/>

  <owl:NamedIndividual rdf:about="sapnexus:MM_Inventory_GetAvailability">
    <rdf:type rdf:resource="sapnexus:Function"/>
    <rdfs:label>MM.Inventory.GetAvailability</rdfs:label>
  </owl:NamedIndividual>
</rdf:RDF>
