<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:sapnexus="https://sap-nexus-agent.local/ontology#">

  <owl:Ontology rdf:about="https://sap-nexus-agent.local/ontology/fi-ap-openitems">
    <owl:imports rdf:resource="https://sap-nexus-agent.local/ontology/core"/>
  </owl:Ontology>

  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#VendorOpenItem">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#BusinessObject"/>
  </owl:Class>

  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#VendorOpenItemsFact">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#ReasoningFact"/>
  </owl:Class>

  <!-- Mirrors predicate declared in ontology/fact-types.yaml. List fact
       (cardinality many): not functional. -->
  <owl:ObjectProperty rdf:about="https://sap-nexus-agent.local/ontology#hasVendorOpenItems">
    <rdfs:domain rdf:resource="https://sap-nexus-agent.local/ontology#VendorOpenItem"/>
    <rdfs:range rdf:resource="https://sap-nexus-agent.local/ontology#VendorOpenItemsFact"/>
  </owl:ObjectProperty>

  <owl:NamedIndividual rdf:about="https://sap-nexus-agent.local/ontology#FI_AP_GetOpenItems">
    <rdf:type rdf:resource="https://sap-nexus-agent.local/ontology#Function"/>
    <rdfs:label>FI.AP.GetOpenItems</rdfs:label>
  </owl:NamedIndividual>
</rdf:RDF>
