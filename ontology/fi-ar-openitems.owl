<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:sapnexus="https://sap-nexus-agent.local/ontology#">

  <owl:Ontology rdf:about="https://sap-nexus-agent.local/ontology/fi-ar-openitems">
    <owl:imports rdf:resource="https://sap-nexus-agent.local/ontology/core"/>
  </owl:Ontology>

  <owl:Class rdf:about="sapnexus:CustomerOpenItem">
    <rdfs:subClassOf rdf:resource="sapnexus:BusinessObject"/>
  </owl:Class>
  <owl:Class rdf:about="sapnexus:CompanyCode"/>
  <owl:Class rdf:about="sapnexus:KeyDate"/>
  <owl:Class rdf:about="sapnexus:AccountingDocumentNumber"/>
  <owl:Class rdf:about="sapnexus:PostingDate"/>
  <owl:Class rdf:about="sapnexus:Amount"/>
  <owl:Class rdf:about="sapnexus:NetDueDate"/>
  <owl:Class rdf:about="sapnexus:ClearingDate"/>

  <owl:NamedIndividual rdf:about="sapnexus:FI_AR_GetOpenItems">
    <rdf:type rdf:resource="sapnexus:Function"/>
    <rdfs:label>FI.AR.GetOpenItems</rdfs:label>
  </owl:NamedIndividual>
</rdf:RDF>
