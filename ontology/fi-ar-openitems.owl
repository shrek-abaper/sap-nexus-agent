<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:sapnexus="https://sap-nexus-agent.local/ontology#">

  <owl:Ontology rdf:about="https://sap-nexus-agent.local/ontology/fi-ar-openitems">
    <owl:imports rdf:resource="https://sap-nexus-agent.local/ontology/core"/>
  </owl:Ontology>

  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#CustomerOpenItem">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#BusinessObject"/>
  </owl:Class>
  <!-- Scalar value types carried directly by BAPI parameters. -->
  <rdfs:Datatype rdf:about="https://sap-nexus-agent.local/ontology#CompanyCode">
    <owl:onDatatype rdf:resource="xsd:string"/>
    <owl:withRestrictions rdf:parseType="Collection">
      <rdf:Description>
        <xsd:pattern rdf:datatype="xsd:string">[A-Z0-9]{1,4}</xsd:pattern>
        <xsd:maxLength rdf:datatype="xsd:nonNegativeInteger">4</xsd:maxLength>
      </rdf:Description>
    </owl:withRestrictions>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="https://sap-nexus-agent.local/ontology#KeyDate">
    <owl:equivalentClass rdf:resource="xsd:date"/>
  </rdfs:Datatype>
  <!-- Plain string alias: tighten with real document-number length when known. -->
  <rdfs:Datatype rdf:about="https://sap-nexus-agent.local/ontology#AccountingDocumentNumber">
    <owl:equivalentClass rdf:resource="xsd:string"/>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="https://sap-nexus-agent.local/ontology#PostingDate">
    <owl:equivalentClass rdf:resource="xsd:date"/>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="https://sap-nexus-agent.local/ontology#Amount">
    <owl:equivalentClass rdf:resource="xsd:decimal"/>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="https://sap-nexus-agent.local/ontology#NetDueDate">
    <owl:equivalentClass rdf:resource="xsd:date"/>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="https://sap-nexus-agent.local/ontology#ClearingDate">
    <owl:equivalentClass rdf:resource="xsd:date"/>
  </rdfs:Datatype>

  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#CustomerOpenItemsFact">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#ReasoningFact"/>
  </owl:Class>

  <!-- Mirrors predicate declared in ontology/fact-types.yaml. List fact
       (cardinality many): not functional. -->
  <owl:ObjectProperty rdf:about="https://sap-nexus-agent.local/ontology#hasCustomerOpenItems">
    <rdfs:domain rdf:resource="https://sap-nexus-agent.local/ontology#CustomerOpenItem"/>
    <rdfs:range rdf:resource="https://sap-nexus-agent.local/ontology#CustomerOpenItemsFact"/>
  </owl:ObjectProperty>

  <owl:NamedIndividual rdf:about="https://sap-nexus-agent.local/ontology#FI_AR_GetOpenItems">
    <rdf:type rdf:resource="https://sap-nexus-agent.local/ontology#Function"/>
    <rdfs:label>FI.AR.GetOpenItems</rdfs:label>
  </owl:NamedIndividual>
</rdf:RDF>
