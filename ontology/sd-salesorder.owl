<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:sapnexus="https://sap-nexus-agent.local/ontology#">

  <owl:Ontology rdf:about="https://sap-nexus-agent.local/ontology/sd-salesorder">
    <owl:imports rdf:resource="https://sap-nexus-agent.local/ontology/core"/>
  </owl:Ontology>

  <owl:Class rdf:about="sapnexus:SalesOrder">
    <rdfs:subClassOf rdf:resource="sapnexus:BusinessObject"/>
  </owl:Class>
  <owl:Class rdf:about="sapnexus:SalesOrderItem"/>
  <owl:Class rdf:about="sapnexus:SalesOrderNumber"/>
  <owl:Class rdf:about="sapnexus:CustomerNumber"/>
  <owl:Class rdf:about="sapnexus:SalesOrganization"/>
  <owl:Class rdf:about="sapnexus:DocumentDate"/>
  <owl:Class rdf:about="sapnexus:NetValue"/>
  <owl:Class rdf:about="sapnexus:Currency"/>
  <owl:Class rdf:about="sapnexus:CustomerPoNumber"/>

  <owl:NamedIndividual rdf:about="sapnexus:SD_SalesOrder_GetList">
    <rdf:type rdf:resource="sapnexus:Function"/>
    <rdfs:label>SD.SalesOrder.GetList</rdfs:label>
  </owl:NamedIndividual>
</rdf:RDF>
