<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:sapnexus="https://sap-nexus-agent.local/ontology#">

  <owl:Ontology rdf:about="https://sap-nexus-agent.local/ontology/core"/>

  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#Capability"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#Skill">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#Capability"/>
  </owl:Class>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#Function">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#Capability"/>
    <!-- Governance invariant mirror: Function = read-only, no approval;
         Action = human approval required. A capability is one or the other.
         The registry contract validator remains the enforcement gate. -->
    <owl:disjointWith rdf:resource="https://sap-nexus-agent.local/ontology#Action"/>
  </owl:Class>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#Action">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#Capability"/>
  </owl:Class>

  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#BusinessObject"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#ReasoningFact"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#RecommendationPlan"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#ApprovalRecord"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#ActionResult"/>

  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#ExecutorBinding"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#TechnicalAdapter"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#JcoRfcBinding">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#ExecutorBinding"/>
  </owl:Class>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#ODataBinding">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#ExecutorBinding"/>
  </owl:Class>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#CdsAdtBinding">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#ExecutorBinding"/>
  </owl:Class>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#CdsODataBinding">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#ExecutorBinding"/>
  </owl:Class>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#RestJsonBinding">
    <rdfs:subClassOf rdf:resource="https://sap-nexus-agent.local/ontology#ExecutorBinding"/>
  </owl:Class>

  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#ExternalSystem"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#CredentialReference"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#JsonRequestSchema"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#JsonResponseSchema"/>
  <owl:Class rdf:about="https://sap-nexus-agent.local/ontology#ResponseMapping"/>
</rdf:RDF>
