sapnexus:Shape.MM_Inventory_GetAvailability.material a sh:NodeShape ;
    sh:name "material" ;
    sapnexus:forCapability sapnexus:MM_Inventory_GetAvailability ;
    sapnexus:forInput "material" ;
    sapnexus:required true ;
    sh:datatype xsd:string ;
    sh:minLength 1 ;
    sh:maxLength 40 .
