# SAP Nexus Java JCo Gateway + Python OData service local smoke-test configuration.
# Copy to .env and fill with real values; never commit .env.

# Required by both SAP JCo (gateway) and SAP OData (odata-service) paths.
# SAP_URL is the OData HTTP base URL; SAP_ASHOST/SAP_SYSNR are for JCo native.
SAP_URL=https://sap.example.local:44300
SAP_ASHOST=sap.example.local
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=YOUR_SAP_USER
SAP_PASSWORD=YOUR_SAP_PASSWORD
SAP_LANG=ZH

# Optional: SAP router string when required by the network path.
# SAP_SAPROUTER=/H/router.example.local/S/3299

# Optional: OData HTTP timeout in seconds (odata-service only; default 30).
# SAP_ODATA_TIMEOUT_SECONDS=30

# Optional: set to 1 to enable gated live OData integration tests (default skip).
# SAP_ODATA_LIVE=1

# Required for local live smoke tests when the native library is not on java.library.path.
# start.sh already defaults SAP_JCO_LIB_PATH to services/gateway/jco/lib/linux and exports
# JAVA_TOOL_OPTIONS (-Djava.library.path) for the Gateway JVM; override here only if relocated.
SAP_JCO_LIB_PATH=/absolute/path/to/sap-nexus-agent/services/gateway/jco/lib/linux

# Required for Agent -> Gateway approval registration. Generate a strong random
# value in local .env; the browser never receives this token.
SAP_NEXUS_APPROVAL_TOKEN=replace-with-random-approval-service-token

# Optional: OpenAI-compatible model gateway for Agent intent parsing.
# Copy real values to local .env only; never commit real model credentials.
LLM_API_KEY=replace-with-model-gateway-key
LLM_BASE_URL=https://modelgateway.nioint.com/publicService
LLM_MODEL_NAME=DeepSeek-V4-Flash
LLM_MAX_RETRIES=3
LLM_TIMEOUT_INTENT=12
