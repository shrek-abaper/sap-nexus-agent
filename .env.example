# SAP Nexus local runtime configuration.
# Copy to .env, replace placeholders, and never commit .env or real credentials.

# --- SAP destination (canonical, unified) ------------------------------------
# One address serves all three access paths on the same application server:
#   - JCO_RFC (Java Gateway, JCo):      SAP_ASHOST + SAP_SYSNR (RFC port = 33<SYSNR>)
#   - ODATA   (odata-service proxy):    SAP_ASHOST + SAP_HTTP_PORT (ICM HTTP)
#   - REST_JSON (Java Gateway, SICF rest2rfc): SAP_ASHOST + SAP_HTTP_PORT (same
#     ICM HTTP port as OData; the paths differ, the address does not)
# There is NO SAP_URL and NO SAP_REST2RFC_*: those were retired in favor of
# this pair. Identity (client/user/password/lang) is shared by all paths.
SAP_ASHOST=sap.example.local
SAP_HTTP_PORT=8000

# JCo-only: system number (two digits). Not used by ODATA / REST_JSON.
SAP_SYSNR=00

# Shared identity for JCO_RFC / ODATA / REST_JSON. Keep real values only in
# .env (gitignored); never commit them.
SAP_CLIENT=100
SAP_USER=YOUR_SAP_USER
SAP_PASSWORD=YOUR_SAP_PASSWORD
SAP_LANG=ZH

# Optional: SAP router string when required by the JCo network path.
# SAP_SAPROUTER=/H/router.example.local/S/3299

# Optional: OData HTTP timeout in seconds (odata-service only; default 30).
# SAP_ODATA_TIMEOUT_SECONDS=30

# Optional: JCo native library directory. start.sh defaults to
# services/gateway/jco/lib/linux; override only when the library is relocated or
# the Gateway is started without start.sh.
# SAP_JCO_LIB_PATH=/absolute/path/to/sap-nexus-agent/services/gateway/jco/lib/linux

# --- Governed Action approval -----------------------------------------------
# Required for Agent/Workbench -> Gateway approval registration. Generate a
# strong random value in local .env; never expose it to browser code.
SAP_NEXUS_APPROVAL_TOKEN=replace-with-random-approval-service-token

# Optional: Python approval lifetime and approval trace directory. Invalid TTL
# values fall back to 600 seconds; the Gateway rejects approvals above 600.
# SAP_NEXUS_APPROVAL_TTL_SECONDS=600
# SAP_NEXUS_TRACE_DIR=runtime/traces

# --- OpenAI-compatible LLM ---------------------------------------------------
# LLM_API_KEY and LLM_BASE_URL are required for live LLM intent parsing, and
# serve as the fallback LLM config of the in-process dsh conversation runtime
# (used whenever the SAP_NEXUS_LLM_* values at the bottom are unset).
# Model, retry count, and timeout have code defaults but are explicit here so
# local behavior is reproducible.
LLM_API_KEY=replace-with-model-gateway-key
LLM_BASE_URL=https://example.com
LLM_MODEL_NAME=DeepSeek-V4-Flash
LLM_MAX_RETRIES=3
LLM_TIMEOUT_INTENT=12

# --- Runtime endpoints and launcher overrides -------------------------------
# These values have local defaults in start.sh and runtime adapters.
# SAP_NEXUS_GATEWAY_URL=http://127.0.0.1:8080
# SAP_GATEWAY_ODATA_PROXY_URL=http://127.0.0.1:8081
# SAP_NEXUS_INTENT_MODE=hybrid
# SAP_NEXUS_AGENT_ROOT=/absolute/path/to/sap-nexus-agent
# SAP_NEXUS_AGENT_PYTHON=/absolute/path/to/sap-nexus-agent/.venv/bin/python

# Port, host, toolchain, and runtime-directory overrides should be exported in
# the shell before invoking start.sh. Some launcher preflight work occurs before
# root .env is loaded, so setting these only in .env can make preflight disagree
# with the services that are started.
# GATEWAY_PORT=8080
# ODATA_SERVICE_PORT=8081
# FRONTEND_PORT=3000
# FRONTEND_HOST=0.0.0.0
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# GRADLE_USER_HOME=/tmp/gradle-home
# START_RUNTIME_DIR=runtime/dev-services

# --- Decision trace (dsh) ----------------------------------------------------
# Default path is runtime/traces/decisions.jsonl (relative to the repo root).
# Set to 0/off/false to disable decision trace recording entirely.
# SAP_NEXUS_DECISION_TRACE=runtime/traces/decisions.jsonl

# --- Read resolution context (legacy intent path) ---------------------------
# Selects the read-context resolution mode; v2 is the default.
# READ_CONTEXT_MODE=v2

# --- Durable state and execution --------------------------------------------
# Relative paths resolve from the owning service process working directory.
# WORKBENCH_DATA_DIR=.workbench-data
# SAP_NEXUS_GATEWAY_DATA_DIR=.gateway-data
# WORKER_ID=worker-local-1
# READ_PLAN_EXECUTOR_MAX_CONCURRENCY=4

# --- Gateway registry, bindings, and trace paths -----------------------------
# start.sh supplies repository-absolute defaults for all three values.
# SAPNEXUS_REGISTRY_PATH=/absolute/path/to/sap-nexus-agent/registry/capabilities.yaml
# SAPNEXUS_REGISTRY_BINDINGS_PATH=/absolute/path/to/sap-nexus-agent/registry/executor-bindings.yaml
# SAPNEXUS_TRACE_PATH=/absolute/path/to/sap-nexus-agent/runtime/gateway-jco/traces.jsonl

# --- Ontology dynamic read analysis (dsh analyze_business_question) ---------
# Offline by default: without this flag the tool answers only the six closed
# questionType cases via checked-in fake interpreter/gateway fixtures and never
# spends model tokens. Set to 1 to register the tool in the DSH registry at all;
# leave unset (or any other value) and the closed four-tool surface is unchanged.
# SAP_NEXUS_ONTOLOGY_ANALYSIS_ENABLED=1
#
# When the tool is enabled, its free-form "question" parameter is still routed
# to the offline fake interpreter unless SAP_NEXUS_LLM_LIVE=1 below is also set.
# The Python runtime independently re-checks SAP_NEXUS_LLM_LIVE, so TS cannot
# alone authorize a paid model call.

# --- Explicit live-test gates ------------------------------------------------
# Live tests / paid model interpretation are skipped unless set to 1.
# SAP_ODATA_LIVE=1       # odata-service live spike tests (tests/test_live_spike.py)
# SAP_REST2RFC_LIVE=1    # REST_JSON <-> JCo live equivalence gate (tests/live/)
# SAP_NEXUS_LLM_LIVE=1   # live LLM intent parsing AND ontology model interpreter
# RUN_PYTHON_INTEGRATION=1   # vitest: also run the real Python subprocess
                            # integration tests (frontend/src/server/dsh)

# SAP_NEXUS_PRINCIPAL: server-owned trusted principal injection (JSON, e.g.
# {"principalId":"user-1","role":"operator","dataScope":{"tenantId":"default"}}).
# Read by the Python CLI subprocess; never supplied by request bodies or LLM
# output. Unset falls back to a documented sandbox placeholder principal.
# SAP_NEXUS_PRINCIPAL=
#
# JAVA_TOOL_OPTIONS, SERVER_PORT, and PYTHONPATH may also appear in child
# processes. They are trusted/internal injection values and are not ordinary
# user configuration in this file.

# --- In-process DeepSeek Harness (Workbench dsh runtime) ---------------------
# Intentional layering, not duplication: dsh reads SAP_NEXUS_LLM_* first and
# falls back to the shared LLM_* values above. Set these ONLY when the dsh
# chat should use a different model/gateway than the agent intent parser;
# otherwise leave them unset (your shared LLM_* values are used).
# SAP_NEXUS_LLM_BASE_URL=https://api.deepseek.com
# SAP_NEXUS_LLM_MODEL=deepseek-chat
# SAP_NEXUS_LLM_API_KEY=replace-with-deepseek-key

# ---------------------------------------------------------------------------
# Master-data entity resolution (PG_MASTERDATA_READ)
# Local dev: PostgreSQL on 127.0.0.1, read-only login role granted md_search_ro
# (see db/migrations/0002_master_data_roles.sql). Password is provisioned via
# your local credential mechanism - never commit real values.
# ---------------------------------------------------------------------------
# PG_MASTERDATA_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/sap_nexus_dev
# PG_MASTERDATA_USER=md_search
# PG_MASTERDATA_PASSWORD=YOUR_PG_PASSWORD
# PG_MASTERDATA_MAPPINGS_PATH=../master-data/physical-mappings.yaml
# Python importer/provider (peer auth uses the OS user; DSN only if needed):
# SAP_NEXUS_MD_DBNAME=sap_nexus_dev
# SAP_NEXUS_MD_DSN=
# Integration-test database name (pytest agent/tests/test_master_data_*):
# SAP_NEXUS_MD_TEST_DBNAME=sap_nexus_test
# Master-data entity resolution master switch. on = description-driven
# search/ENTITY_CHOICE in the governed read path; off/unset = legacy
# code-entry behavior is fully preserved. Read from process env with a repo
# .env fallback (both the Python CLI and the TS facade).
ENTITY_RESOLUTION_MODE=off
