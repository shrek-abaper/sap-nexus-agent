      "replayWithReorderedFacts": true,
      "assertNoExecutionEvidence": true
    },
    {
      "id": "sufficient-stock-no-action",
      "requiredQuantity": 7,
      "expectedStatus": "NO_ACTION",
      "expectedProposalCount": 0
    },
    {
      "id": "missing-required-quantity",
      "omitConstraint": "requiredQuantity",
      "expectedStatus": "CLARIFY",
      "expectedLimitationCode": "MISSING_CONSTRAINT_REQUIRED_QUANTITY",
      "expectedProposalCount": 0
    },
    {
      "id": "missing-target-date",
      "omitConstraint": "targetDate",
      "expectedStatus": "CLARIFY",
      "expectedLimitationCode": "MISSING_CONSTRAINT_TARGET_DATE",
      "expectedProposalCount": 0
    },
    {
      "id": "missing-purchasing-group",
