{
  "name": "sap-nexus-harness-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Replaceable DeepSeek Harness runtime for SAP Nexus; calls only the server-owned semantic tool facade.",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "sap-nexus-dsh": "lib/bin.js"
  },
  "files": [
    "lib",
    "config"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node lib/bin.js",
    "dev": "tsx src/bin.ts",
    "dump-config": "node lib/bin.js --dump-config"
  },
