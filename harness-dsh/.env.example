# Copy to .env (gitignored). Placeholders only — never commit real keys.
# OpenAI-compatible LLM endpoint used by the dsh pi-ai provider route "sapnexus".
SAP_NEXUS_LLM_PROVIDER=sapnexus
SAP_NEXUS_LLM_MODEL=deepseek-chat
SAP_NEXUS_LLM_BASE_URL=https://api.deepseek.com
SAP_NEXUS_LLM_API_KEY=<your-api-key-here>

# Server-owned semantic tool facade (Next app).
SAP_NEXUS_FACADE_URL=http://127.0.0.1:3000
SAP_NEXUS_FACADE_TIMEOUT_MS=60000
